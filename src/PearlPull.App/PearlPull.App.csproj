<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AppRole Condition="'$(AppRole)' == ''">Button</AppRole>
    <AssemblyName>PearlPull$(AppRole)</AssemblyName>
    <RootNamespace>PearlPull.Tray</RootNamespace>
    <LangVersion>5</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.6.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants Condition="'$(AppRole)' == 'Receiver'">$(DefineConstants);RECEIVER</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.CSharp" />
    <Compile Include="../PearlPull.Core/PearlPull.cs" Link="PearlPull.cs" />
    <Compile Include="../PearlPull.Core/Pairing.cs" Link="Pairing.cs" />
    <EmbeddedResource Include="../../assets/pearl-pull.png" LogicalName="PearlPull.png" />
  </ItemGroup>
</Project>
